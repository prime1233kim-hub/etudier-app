# Copy this file to ".env" and fill in your own values.
# Never share your real .env file or put it on GitHub.
# Without any key, the site still runs and offers a clearly labelled demo.

# ---- Option A: FREE — Google Gemini --------------------------------------
# Get a key at https://aistudio.google.com → "Get API key" (no card needed).
# The free plan has daily limits, and Google may use what it receives on the
# free plan to improve its products.
GEMINI_API_KEY=

# Optional: models (defaults shown). Source research uses Google Search,
# which the free plan only includes with the 2.5 models.
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_RESEARCH_MODEL=gemini-2.5-flash

# ---- Option B: PAID — Anthropic Claude -----------------------------------
# Get a key at https://console.anthropic.com → API Keys (pay per use).
# ANTHROPIC_API_KEY=
# ETUDIER_MODEL=claude-opus-5-5
# ETUDIER_EFFORT=medium
# ETUDIER_RESEARCH_EFFORT=medium
# RESEARCH_MAX_SEARCHES=6

# If both keys are set, Claude is used. Force one with:
# AI_PROVIDER=gemini

# ---- Everything else is optional -----------------------------------------
# Set to "off" to switch source research off (analysis still works).
# RESEARCH_PROVIDER=on

# Requests allowed per visitor every 10 minutes.
# ANALYZE_LIMIT=10
# RESEARCH_LIMIT=8

# Where archive entries and thumbnails are stored (default: ./data).
# On Render, point this at a persistent disk, e.g. /var/data
# DATA_DIR=

# Port for the web server (Render sets this automatically).
# PORT=3400
