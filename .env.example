# Copy this file to ".env" and fill in your own values.
# Never share your real .env file or put it on GitHub.

# Required for real AI analysis and source research.
# Get a key at https://console.anthropic.com → API Keys.
# Without it, the site still runs and offers a clearly labelled demo.
ANTHROPIC_API_KEY=

# Optional: which Claude model to use (default: claude-opus-5-5).
# ETUDIER_MODEL=claude-opus-5-5

# Optional: how hard the model thinks — low, medium, high (default: medium).
# ETUDIER_EFFORT=medium
# ETUDIER_RESEARCH_EFFORT=medium

# Source research uses Claude's built-in web search (same key as above).
# Set to "off" to switch research off; the garment analysis still works.
# RESEARCH_PROVIDER=anthropic
# RESEARCH_MAX_SEARCHES=6

# Optional: requests allowed per visitor every 10 minutes.
# ANALYZE_LIMIT=10
# RESEARCH_LIMIT=8

# Optional: where archive entries and thumbnails are stored (default: ./data).
# On Render, point this at a persistent disk, e.g. /var/data
# DATA_DIR=

# Port for the web server (Render sets this automatically).
# PORT=3400
